# Binários. Os nomes soltos são os que `go build ./cmd/<x>` deixa na raiz:
# sem eles, um build distraído commita megabytes de binário.
/out/
/bin/
/dist/
/api-bin
/gerar-openapi
/fiscal-worker

# Ambiente
.env
.env.*
!.env*.example

# Artefatos nativos da ACBrLib: NÃO versionados. São assets de release,
# baixados por scripts/baixar-acbr-libs.sh: este diretório é só cache local.
/acbr-libs/

# Cache local dos fontes ACBr (make acbr-update)
/acbr-source/

# Go
*.test
*.out
/vendor/

# Editores
.idea/
.vscode/
*.swp

# Configuração local do Claude Code (por usuário)
.claude/settings.local.json

# Cache do fonte do ACBr (~640 MB), populado por "make acbr-fonte".
/acbr-source/
