+// wrapper-api: a Distribuicao DF-e do ADN passou a exigir o cnpjConsulta.
+// Sem ele a consulta volta REJEICAO (HTTP 400, sem nenhum erro listado),
+// inclusive com o certificado do proprio CNPJ. O componente ja monta o
+// parametro (ACBR-9006) quando recebe o CNPJ, mas a lib so exportava a
+// consulta por NSU. Mesmo corpo do ConsultarDFe, com o CNPJ.
+function TACBrLibNFSe.ConsultarDFePorCNPJ(const aCNPJ: PAnsiChar; aNSU: Integer; sResposta: PAnsiChar; var esTamanho: Integer): Integer;
+var
+  Resp: TConsultaDFeResposta;
+  Resposta: AnsiString;
+  CNPJ: String;
+begin
+  try
+    CNPJ := ConverterStringEntrada(aCNPJ);
+
+    if Config.Log.Nivel > logNormal then
+      GravarLog('NFSE_ConsultarDFePorCNPJ(' + CNPJ + ', ' + IntToStr(aNSU) + ' )', logCompleto, True)
+      else
+      GravarLog('NFSE_ConsultarDFePorCNPJ', logNormal);
+
+    NFSeDM.Travar;
+    try
+      NFSeDM.ACBrNFSeX1.ConsultarDFe(CNPJ, aNSU);
+      Resp := TConsultaDFeResposta.Create(Config.TipoResposta, Config.CodResposta);
+
+      if Config.Log.Nivel = logParanoico then
+        GravarLogsHttp('NFSE_ConsultarDFePorCNPJ', NFSeDM.ACBrNFSeX1.WebService.ConsultarDFe);
+
+      try
+        Resp.Processar(NFSeDM.ACBrNFSeX1.WebService.ConsultarDFe);
 
         Resposta:= Resp.Gerar;
         MoverStringParaPChar(Resposta, sResposta, esTamanho);
