+// wrapper-api: o municipio da chave e o do documento. O cLocEmi informado vence
+// o da sessao porque a sessao escolhe a classe do provedor: um emitente do
+// Simples em municipio de emissor proprio sai pela classe do Padrao Nacional
+// com a sessao em outro municipio, e a chave nao pode carregar esse municipio.
+// Com cLocEmi igual ao da sessao, ou vazio, o resultado nao muda.
+function TNFSeW_PadraoNacional.CodigoMunicipioChave: Integer;
+begin
+  Result := StrToIntDef(NFSe.cLocEmi, 0);
+
+  if Result = 0 then
+    Result := CodMunEmit;
+
+  if Result = 0 then
+    Result := CodigoLocalEmissao;
+end;
