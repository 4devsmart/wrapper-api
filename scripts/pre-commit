#!/usr/bin/env bash
# O pre-commit: so o que cabe em segundos — formatar os arquivos staged e
# coloca-los de volta no stage. FORMAT_ON_COMMIT=0 desliga.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/flow-lib.sh"

[ "$FORMAT_ON_COMMIT" = 1 ] || exit 0

# Arquivos parcialmente staged nao sao formatados: `git add` depois levaria ao
# commit o trecho que a pessoa deixou de fora.
staged_whole() {
  local glob="$1" f
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    git diff --quiet -- "$f" && printf '%s\n' "$f"
  done < <(git diff --cached --name-only --diff-filter=ACMR -- "$glob")
}

case "$STACK" in
  php)
    mapfile -t files < <(staged_whole '*.php')
    [ ${#files[@]} -gt 0 ] || exit 0
    ./scripts/php vendor/bin/pint "${files[@]}"
    git add -- "${files[@]}"
    ;;
  go)
    mapfile -t files < <(staged_whole '*.go')
    [ ${#files[@]} -gt 0 ] || exit 0
    gofmt="$(command -v gofmt || echo "$HOME/.local/go/bin/gofmt")"
    "$gofmt" -w "${files[@]}"
    git add -- "${files[@]}"
    ;;
esac
